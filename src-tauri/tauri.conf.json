{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "1.2.0",
  "identifier": "com.pulse.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "Pulse Settings",
        "width": 760,
        "height": 540,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "maximizable": true,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "index.html#overlay",
        "width": 440,
        "height": 220,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNEM4NTFGREVCRDc0MzIKUldReWRMM2VINFZNVTdiS1RuaXBuYXIxNldaN2VvME1hVVc1V2UzMjVuYXZFMUNZdEJUVVJVOXMK",
      "endpoints": [
        "https://github.com/Kanad-Shee/pulse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
